---
import { getCollection } from "astro:content";
import PersonCard from "../components/PersonCard.astro";
import Navigation from '../components/Navigation.astro';
import Layout from '../layouts/Layout.astro';

const people = await getCollection("team");

people.sort((a, b) =>
  a.data.lastname.localeCompare(b.data.lastname)
);

const categories = [
	{ key: "permanent", title: "Permanent Staff" },
	{ key: "ext", title: "External Collaborators" },
	{ key: "postdoc", title: "Postdocs" },
	{ key: "phd", title: "PhD Students" },
	{ key: "eng", title: "Engineers" },
	{ key: "alumni", title: "Alumni" },
];
---

<Layout>
	<Navigation />

	<main>
		<section class="main">
			<h1>Members of Khora</h1>

			{categories.map(({ key, title }) => {
				const members = people.filter(
					(person) => person.data.category === key
				);

				if (members.length === 0) return null;

				return (
					<section class="team-section">
						<header class="section-header">
							<h2>{title}</h2>
						</header>

						<div class="team-grid">
							{members.map((person) => (
								<PersonCard person={person} />
							))}
						</div>
					</section>
				);
			})}
		</section>
	</main>
</Layout>


<style>
	.team-section {
		margin-top: 1rem;
	}

	.section-header {
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.15);
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 3rem 2rem;
		padding-top: 1rem;
	}
</style>