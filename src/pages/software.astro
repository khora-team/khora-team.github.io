---
import { getCollection } from "astro:content";
import Navigation from "../components/Navigation.astro";
import Layout from "../layouts/Layout.astro";
import SoftwareCard from "../components/SoftwareCard.astro";

const entries = await getCollection("software");
const softwares = entries
	.map((sw) => ({
		id: sw.id,
		data: sw.data,
		body: sw.body,
	}))
	.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout>
	<Navigation />

	<section class="main">
		<h1>Software</h1>
		<div class="team-grid">
			{softwares.map((sw) => <SoftwareCard software={sw} />)}
		</div>
	</section>
</Layout>

<style>
	.team-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 2rem;
	}
</style>
