---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";

const teamSummary = `Software developers now have to explore and operate within an increasingly complex and constantly evolving design space, while having to deal with deploying new software releases faster. Khora is developing a research activity in software engineering to help developers in mastering their increasingly complex design space. To do so, Khora develops new scientific theories, approaches, and techniques related to exploratory programming, a development mode to try out, compare, explore different versions of software artifacts. Khora's research agenda implies working on: 1. domain-specific IDEs and digital twins to help developers master their development design space through novel exploratory programming features (augmented development environment); 2. large-scale, polyglot, AI-based, code analysis techniques to underpin exploratory programming (augmented code analysis). The application domains of Khora encompass software engineering with software artifacts (co-)evolution and optimization (e.g., reduce software energy consumption) and scientific computing to help scientists in their complex software development.`;

const workplace = `Khora is a research group part of the IRISA laboratory (a mixed research unit grouping CNRS, University of Rennes, Inria, INSA Rennes), Rennes, France.`;
---

<Layout
	title="Khora — Empirical Software Engineering Research Group"
	description="Khora research group in empirical software engineering at IRISA, Rennes."
>
	<Navigation />

	<main>
		<section class="main">
			<div class="main-content">
				<h1 class="team-name">Khora</h1>
				<p class="eyebrow">IRISA · Rennes, France</p>
				<p class="main-text-light">
					Research group in empirical software engineering at the IRISA laboratory, Rennes, France.
				</p>

				<p class="main-text">
					{teamSummary}
				</p>

				<p class="main-text">
					{workplace}
				</p>
				<div class="affiliations">
					<span>IRISA</span>
					<span>CNRS</span>
					<span>University of Rennes</span>
					<span>Inria</span>
					<span>INSA Rennes</span>
				</div>
			</div>


		</section>

		<section class="section-divider main">
			<div class="main-content">
				<p class="main-text">Exploratory programming requires a research agenda that involves studying both HCI (Human-
					Computer Interaction) and software engineering research paths. KHORA's research agenda thus implies
					working on:</p>
			</div>
		</section>

		<section class="main axes">
			<article class="axis-card">
				<span class="axis-number">01</span>
				<div>
					<p class="axis-label">Augmented Development Environment</p>
					<p class="main-text">
						By taking the perspective of developers, this axis will characterize and develop exploratory pro-
						gramming and propose novel approaches to build domain-specific and cutting-edge development
						environments (IDEs and digital twins) supporting domain-specific exploratory programming.
						Scientific contributions had worked on related topics, but they are mainly related to general-
						purpose languages (GPLs) and their general-purpose IDEs. Moreover, those contributions lack to
						work on easing the creation of domain-specific and highly interactive IDEs and digital twins.
					</p>
				</div>
			</article>

			<article class="axis-card">
				<span class="axis-number">02</span>

				<div>
					<p class="axis-label">Augmented Code Analysis</p>
					<p class="main-text">
						The previous research axe focuses on the HCI engineering facets of exploratory programming.
						Building such a development mode, however, requires a research agenda in software (language)
						engineering.
					</p>
				</div>
			</article>
		</section>

	</main>
</Layout>

<style>
	.team-name {
		margin: 0;
		font-size: clamp(3.5rem, 7vw, 7.5rem);
		line-height: 0.88;
		letter-spacing: -0.075em;
		font-weight: 650;
	}

	.axes {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
	}

	.axis-card {
		position: relative;
		min-height: 450px;
		padding: 55px clamp(24px, 5vw, 75px);
		display: grid;
		grid-template-columns: 50px 1fr;
		gap: 20px;
	}

	.axis-card + .axis-card {
		border-left: 1px solid rgba(23, 24, 23, 0.15);
	}

	.axis-number,
	.axis-label {
		margin: 0 0 30px;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-weight: 700;
	}

	.axis-card p:not(.axis-label) {
		position: absolute;
		right: 50px;
		padding: 0 0 0 30px;
	}

	.affiliations {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 55px;
	}

	.affiliations span {
		padding: 10px 15px;
		border: 1px solid rgba(23, 24, 23, 0.2);
		font-size: 0.75rem;
	}

	.section-divider::before {
		content: "";
		display: block;
		width: 60%;
		height: 1px;
		margin: 0 auto;
		background: rgba(23, 24, 23, 0.12);
	}
</style>
