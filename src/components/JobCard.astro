---
import { Icon } from "astro-icon/components";
import { Image } from 'astro:assets';
import { render } from "astro:content";

interface JobData {
    job: {
        id: string;
        data: {
            title: string;
            position: string;
        };
    };
}

const { job } = Astro.props as JobData;

---

<article class="job-card">
  <span class="job-type">
    {job.data.position}
  </span>

    <h2>{job.data.title}</h2>

    <a
            class="details"
            href={`/jobs/${job.id}/`}
    >
        More details
        <span aria-hidden="true">→</span>
    </a>
</article>

<style>
    .job-card {
        padding: 2rem 0;
        border-top: 1px solid rgba(0, 0, 0, 0.12);
    }

    .job-card:last-child {
        border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    }

    .job-type {
        display: block;
        margin-bottom: 0.6rem;

        color: #777;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .job-card h2 {
        margin: 0;

        font-size: 1.35rem;
        line-height: 1.35;
        font-weight: 600;
    }

    .details {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;

        margin-top: 1.25rem;

        color: inherit;
        text-decoration: none;

        font-size: 0.85rem;
        font-weight: 600;

        transition: gap 0.2s ease;
    }

    .details:hover {
        gap: 1rem;
    }
</style>