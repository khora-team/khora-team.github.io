---
import { type Publication } from '../models/Publication.model'

interface Props {
    publication: Publication
}

const { publication } = Astro.props;
---

<article class="publication-card">
    <div class="publication-meta">
        <span class="publication-year">
            {publication.year}
        </span>

        {
            publication.type && (
                <span class="publication-type">{publication.type}</span>
            )
        }
    </div>

    <div class="publication-content">
        <h2>{publication.title}</h2>

        {
            publication.authors.length > 0 && (
                <p class="publication-authors">
                    {publication.authors.join(", ")}
                </p>
            )
        }

        {
            publication.venue && (
                <p class="publication-venue">{publication.venue}</p>
            )
        }

        {
            publication.keywords?.length > 0 && (
                <ul class="publication-keywords" aria-label="Keywords">
                    {publication.keywords.map((keyword) => (
                        <li>{keyword}</li>
                    ))}
                </ul>
            )
        }

        <div class="publication-links">
            {
                publication.url && (
                    <a
                        href={publication.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        HAL
                    </a>
                )
            }

            {
                publication.pdf && (
                    <a
                        href={publication.pdf}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        PDF
                    </a>
                )
            }

            {
                publication.doi && (
                    <a
                        href={`https://doi.org/${publication.doi}`}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        DOI
                    </a>
                )
            }
        </div>
    </div>
</article>

<style>
    .publication-card {
        display: grid;
        grid-template-columns: 100px 1fr;
        gap: 32px;

        padding: 12px 0;
        border-top: 1px solid rgba(23, 24, 23, 0.1);
    }

    .publication-card:first-child {
        border-top: none;
    }

    .publication-meta {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .publication-year {
        font-size: 1rem;
        font-weight: 600;
    }

    .publication-type {
        color: #777;
        font-size: 0.75rem;
        line-height: 1.3;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .publication-content h2 {
        margin: 0 0 4px 0;
        font-size: 1.2rem;
        line-height: 1.35;
        font-weight: 600;
    }

    .publication-authors {
        margin: 0 0 4px 0;
        color: #444;
        line-height: 1.5;
    }

    .publication-venue {
        margin: 0;
        color: #777;
        font-style: italic;
        line-height: 1.5;
    }

    .publication-keywords {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;

        margin: 10px 0 0;
        padding: 0;

        list-style: none;
    }

    .publication-keywords li {
        padding: 3px 8px;

        border: 1px solid rgba(23, 24, 23, 0.15);
        border-radius: 999px;

        color: #666;
        background: rgba(23, 24, 23, 0.03);

        font-size: 0.75rem;
        line-height: 1.4;
    }

    .publication-links {
        display: flex;
        gap: 16px;
        margin-top: 10px;
    }

    .publication-links a {
        color: inherit;
        font-size: 0.85rem;
        font-weight: 600;
    }
</style>
